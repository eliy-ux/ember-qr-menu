rules_version = '2';

function isAdmin() {
  return request.auth != null
    && (
      !get(/databases/$(database)/documents/roles/$(request.auth.token.email.lower())).exists
      || get(/databases/$(database)/documents/roles/$(request.auth.token.email.lower())).data.role == 'admin'
    );
}

function isStaff() {
  return request.auth != null
    && get(/databases/$(database)/documents/roles/$(request.auth.token.email.lower())).exists
    && get(/databases/$(database)/documents/roles/$(request.auth.token.email.lower())).data.role == 'staff';
}

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'Pending'
                    && request.resource.data.tableNumber is string
                    && request.resource.data.items is list;
      allow read: if request.auth != null;
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    match /orderTracking/{orderId} {
      allow read: if true;
      allow create: if isAdmin() || isStaff()
                    || (request.resource.data.status == 'Pending'
                        && request.resource.data.orderId == orderId
                        && request.resource.data.deviceId is string
                        && request.resource.data.tableNumber is string
                        && request.resource.data.total is number);
      allow update, delete: if isAdmin() || isStaff();
    }

    match /serviceRequests/{requestId} {
      allow create: if request.resource.data.status == 'Pending'
                    && request.resource.data.type == 'waiter'
                    && request.resource.data.tableNumber is string;
      allow read, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /roles/{userId} {
      allow read: if request.auth != null && request.auth.token.email.lower() == userId;
      allow write: if isAdmin();
    }
  }
}
